# InventoryX API origin (no secrets). Backend default in dev: http://localhost:5291
# The Vite SPA runs separately on http://localhost:5173 — do not point both at the same URL unless they are co-hosted.
VITE_INVENTORYX_ORIGIN=http://localhost:5291

# Optional scrubbed telemetry. Leave empty to disable.
VITE_SENTRY_DSN=
VITE_TELEMETRY_ENABLED=false
