{
  "name": "inventoryms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Typed InventoryX Cycle 1 inventory and POS frontend",
  "author": "Adam Tungtaiya Lukman <your-email@example.com>",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maestro-00/InventoryMS.git"
  },
  "bugs": {
    "url": "https://github.com/maestro-00/InventoryMS/issues"
  },
  "homepage": "https://github.com/maestro-00/InventoryMS#readme",
  "keywords": [
    "inventory",
    "pos",
    "point-of-sale",
    "react",
    "typescript",
    "inventoryx"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:live": "sh -c 'fuser -k 5173/tcp 2>/dev/null || true; exec playwright test -c playwright.live.config.ts'",
    "test:e2e:offline": "playwright test tests/e2e/us4-offline-browser.spec.ts tests/e2e/us4-offline-quality.spec.ts --project=chromium",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:responsive": "playwright test --grep @responsive --project=chromium",
    "test:performance": "pnpm build && node scripts/check-bundle-budget.mjs && lhci autorun",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "api:generate": "node scripts/openapi-generate.mjs",
    "api:check": "node scripts/openapi-check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-table": "9.1.2",
    "@zxing/browser": "0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "dexie": "4.4.4",
    "lucide-react": "1.30.0",
    "minisearch": "7.2.0",
    "openapi-fetch": "0.17.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.4.0",
    "web-vitals": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.30",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "16.4.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "shadcn": "4.16.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
